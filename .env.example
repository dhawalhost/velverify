# WardSeal Unified Configuration Template
# =====================================
# Use this file as a template for your .env file.
# Copy it locally: cp .env.example .env

# [General]
APP_ENVIRONMENT=development
DOCKER_API_VERSION=1.41

# [Database]
APP_DATABASE_HOST=localhost
APP_DATABASE_PORT=5432
APP_DATABASE_USER=user
APP_DATABASE_PASSWORD=password
APP_DATABASE_NAME=identity_platform
APP_DATABASE_SSLMODE=disable

# [Auth Service]
APP_AUTH_BASE_URL=http://localhost:8080
APP_AUTH_UI_URL=http://localhost:5173
APP_AUTH_DEPLOYMENT_MODE=saas
APP_AUTH_SERVICE_AUTH_TOKEN=dev-secret-change-me
APP_AUTH_SERVICE_AUTH_HEADER=X-Service-Auth
APP_AUTH_DIRECTORY_SERVICE_URL=http://localhost:8081
APP_AUTH_JWT_PRIVATE_KEY_PATH=/etc/wardseal/keys/private_key.pem
APP_AUTH_JWT_PUBLIC_KEY_PATH=/etc/wardseal/keys/public_key.pem

# [Auth Redis & Rate Limiting]
APP_AUTH_REDIS_ADDR=localhost:6379
APP_AUTH_REDIS_DB=0
APP_AUTH_REDIS_PASSWORD=
APP_AUTH_WEBAUTHN_SESSION_TTL=10m
APP_AUTH_RATE_LIMIT_USE_TENANT=true
APP_AUTH_RATE_LIMIT_KEY_PREFIX=authsvc:ratelimit

# [Directory Service]
APP_DIRECTORY_SERVICE_AUTH_TOKEN=dev-secret-change-me
APP_DIRECTORY_SERVICE_AUTH_HEADER=X-Service-Auth

# [Governance Service]
APP_GOVERNANCE_DIRECTORY_SERVICE_URL=http://localhost:8081
APP_GOVERNANCE_WEBHOOK_SECRET=gov-secret
APP_GOVERNANCE_CORS_ALLOWED_ORIGINS=http://localhost:5173

# [Observability]
APP_OBSERVABILITY_LOG_LEVEL=info
APP_OBSERVABILITY_SERVICE_NAME=wardseal
APP_OBSERVABILITY_SERVICE_VERSION=v0.1.0
APP_OBSERVABILITY_OTEL_ENDPOINT=

# [KMS - Key Management Service]
APP_KMS_PROVIDER=local
APP_KMS_MASTER_KEY=12345678901234567890123456789012
APP_KMS_PRIVATE_KEY_PATH=/etc/wardseal/keys/private_key.pem
APP_KMS_PUBLIC_KEY_PATH=/etc/wardseal/keys/public_key.pem
APP_KMS_VAULT_ADDR=
APP_KMS_VAULT_TOKEN=
APP_KMS_VAULT_KEY_NAME=wardseal-signing-key
APP_KMS_VAULT_KEY_PATH=transit

# [License]
APP_LICENSE_REQUIRED=false
APP_LICENSE_KEY=
APP_LICENSE_PUBLIC_KEY_PATH=/etc/wardseal/keys/license_public.pem

# [Slack Notifications]
APP_SLACK_ENABLED=false
APP_SLACK_WEBHOOK_URL=
APP_SLACK_BOT_TOKEN=
APP_SLACK_APP_TOKEN=
APP_SLACK_CHANNEL_ID=
