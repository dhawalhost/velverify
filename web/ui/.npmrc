# Registry for the @dhawalhost scope — GitHub Packages
# This file is read by npm when publishing from this directory.
# The NODE_AUTH_TOKEN is injected by GitHub Actions (GITHUB_TOKEN)
# or a Personal Access Token with write:packages scope for local publishing.
@dhawalhost:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
