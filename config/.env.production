# WardSeal Production Configuration
# Non-sensitive production environment settings.
# Secrets are loaded from Vault at: secret/data/wardseal/production

# Environment
ENVIRONMENT=production

# Database (host is production-specific)
DB_HOST=postgres-prod.cluster.local
DB_SSLMODE=verify-full

# Service URLs (internal K8s service names)
AUTH_SERVICE_URL=http://wardseal-authsvc:8080
DIRECTORY_SERVICE_URL=http://wardseal-dirsvc:8081

# Logging (less verbose in production)
LOG_LEVEL=info

# CORS
CORS_ALLOWED_ORIGINS=https://wardseal.com,https://manage.wardseal.com
