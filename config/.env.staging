# WardSeal Staging Configuration
# Non-sensitive staging environment settings.
# Secrets are loaded from Vault at: secret/data/wardseal/staging

# Environment
ENVIRONMENT=staging

# Database (host is staging-specific)
DB_HOST=postgres-staging.cluster.local
DB_SSLMODE=require

# Service URLs (internal K8s service names)
AUTH_SERVICE_URL=http://wardseal-authsvc:8080
DIRECTORY_SERVICE_URL=http://wardseal-dirsvc:8081

# Logging
LOG_LEVEL=debug

# CORS
CORS_ALLOWED_ORIGINS=https://staging.wardseal.com,https://manage-staging.wardseal.com
