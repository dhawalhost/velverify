# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with the
# -o option to specify output file names
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Environment variables (local .env files)
.env
.env.local
.env.*.local
# Allow config/ env files except development secrets
!config/.env.defaults
!config/.env.staging
!config/.env.production
config/.env.development
# Build outputs
/build
/bin
/dist

# IDE settings
.idea/
.vscode/

# OS-specific files
.DS_Store
Thumbs.db
